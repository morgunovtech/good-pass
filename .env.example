# Temp mail provider configuration (defaults to https://www.1secmail.com/api/v1)
# Override BASE_URL + KEY only if you want to use another provider
# TEMP_MAIL_API_BASE_URL=https://api.example-temp-mail.test
# TEMP_MAIL_API_KEY=
# Set to "true" if your provider requires API keys
# TEMP_MAIL_API_REQUIRE_KEY=false

# KV binding обязательно на Pages: создайте namespace и пропишите binding TEMP_MAIL_STORE в wrangler.toml/Pages Settings
