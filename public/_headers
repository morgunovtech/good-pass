# Cloudflare Pages serves public/ without the Express server, so the security
# headers src/server.js sets locally have to be declared here too. The CSP must
# stay identical to the one in src/server.js (test/pages.test.js checks it).
# These rules cover static files only; /api/* answers come from functions/.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; font-src https://s.morgunov.tech; style-src 'self' https://s.morgunov.tech; img-src 'self' data: blob:; script-src 'self'; connect-src 'self'; worker-src 'self'

/404.html
  X-Robots-Tag: noindex
