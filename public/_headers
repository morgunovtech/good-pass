# Cloudflare Pages serves public/ without the Express server, so the security
# headers src/server.js sets locally have to be declared here too.
# No Content-Security-Policy yet: the page still has inline styles and an
# inline script that the CSP in src/server.js blocks (it is broken under its
# own policy locally). Add the CSP here once the page passes it.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/404.html
  X-Robots-Tag: noindex
