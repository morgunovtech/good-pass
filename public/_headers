# Cloudflare Pages serves public/ without the Express server, so the security
# headers src/server.js sets locally have to be declared here too. The CSP must
# stay identical to the one in src/server.js (test/pages.test.js checks it).
# These rules cover static files only; /api/* answers come from functions/.
#
# X-Robots-Tag: noindex on every path: the owner hides the site from search
# engines while it is not ready (2026-11-25); it stays up for people who have
# the link. src/server.js sends the same header locally. To be indexed again,
# drop that one line here, the robots meta tag in index.html and search=no in
# robots.txt, bring sitemap.xml back and bump the service worker cache; the
# /404.html and pages.dev rules below stay either way (Cloudflare joins
# repeated X-Robots-Tag values with a comma, which this header allows).
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; font-src https://s.morgunov.tech; style-src 'self' https://s.morgunov.tech; img-src 'self' data: blob:; script-src 'self'; connect-src 'self'; worker-src 'self'
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex

# good-pass.pages.dev is Cloudflare's technical host for the project; the
# published address is https://good-pass.morgunov.tech, so search engines are
# told not to index the technical one. Preview deployments
# (<hash>.good-pass.pages.dev) already get noindex from Cloudflare.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
